# Copie com npm run setup; edite somente a .env privada, nunca este exemplo.
APP_ORIGIN=http://127.0.0.1:5173
WEB_PORT=5173
APP_DB_NAME=emulador
SESSION_TTL_HOURS=168
MASTER_SESSION_TTL_HOURS=8
MASTER_IDLE_MINUTES=15
CATALOG_VOLUME=emulador-game-boy-dev_catalog_data
# Caminho do arquivo privado lido apenas pelo processo de bootstrap; não é senha.
BOOTSTRAP_ENV_SOURCE=./.env
# Use exatamente APP_ORIGIN no navegador. Este Compose é exclusivo para HTTP local.

# Primeiro boot: escolha usuário (3–32, a-z/0-9/_) e senha (12–128 caracteres).
# Sem MASTER existente, valores vazios/invalidos impedem a inicialização.
# Com MASTER existente, estes valores são ignorados: nunca alteram senha/perfil.
# Aspas simples preservam $ e # literalmente. Não use expansão ${VAR} nem source .env.
# Senha em uma linha, sem apóstrofo interno ou barra invertida final (alternativa: CLI).
ADMIN_USERNAME=''
ADMIN_PASSWORD=''
